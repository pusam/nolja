@echo off
rem Nolja launcher: serves this folder at http://localhost:8765 so Chrome/Edge allow Joy-Con (WebHID).
rem Keep this window open while playing. Close it to stop.
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$r=(Get-Location).Path; $u='http://localhost:8765/'; $mt=@{'.html'='text/html; charset=utf-8';'.js'='text/javascript; charset=utf-8';'.css'='text/css; charset=utf-8';'.json'='application/json';'.png'='image/png';'.svg'='image/svg+xml';'.txt'='text/plain; charset=utf-8'}; $l=New-Object Net.HttpListener; $l.Prefixes.Add($u); try { $l.Start() } catch { Write-Host 'Could not open port 8765:' $_.Exception.Message; Read-Host 'Press Enter to close'; exit 1 }; try { Start-Process chrome $u -ErrorAction Stop } catch { try { Start-Process msedge $u -ErrorAction Stop } catch { Start-Process $u } }; Write-Host ('Nolja is running at ' + $u + '  (close this window to stop)'); while ($l.IsListening) { $c=$l.GetContext(); $p=[Uri]::UnescapeDataString($c.Request.Url.AbsolutePath.TrimStart('/')); $f=Join-Path $r $p; if (($p -ne '') -and (Test-Path -LiteralPath $f -PathType Container) -and (-not $p.EndsWith('/'))) { $c.Response.Redirect('/' + $p + '/'); $c.Response.Close(); continue }; if (($p -eq '') -or $p.EndsWith('/')) { $f=Join-Path $f 'index.html' }; if (($p -notmatch '\.\.') -and (Test-Path -LiteralPath $f -PathType Leaf)) { $b=[IO.File]::ReadAllBytes($f); $e=[IO.Path]::GetExtension($f).ToLower(); if ($mt.ContainsKey($e)) { $c.Response.ContentType=$mt[$e] }; $c.Response.OutputStream.Write($b,0,$b.Length) } else { $c.Response.StatusCode=404 }; $c.Response.Close() }"
