@echo off
rem Nolja launcher: serves this folder at http://localhost:8765 so Chrome/Edge allow Joy-Con (WebHID).
rem Running it again while it is open just reopens the same page (same port keeps settings and Joy-Con permission).
rem If 8765 is taken by another program, it uses the next free port up to 8775.
rem Keep this window open while playing. Close it to stop.
pushd "%~dp0" || (echo Cannot open this folder. & pause & exit /b 1)
if not exist "index.html" (echo index.html is missing here. Extract the whole zip first, then run start-game.bat. & pause & exit /b 1)
powershell -NoProfile -ExecutionPolicy Bypass -Command "$r=(Get-Location).Path; $mt=@{'.html'='text/html; charset=utf-8';'.js'='text/javascript; charset=utf-8';'.css'='text/css; charset=utf-8';'.json'='application/json';'.png'='image/png';'.webp'='image/webp';'.svg'='image/svg+xml';'.txt'='text/plain; charset=utf-8'}; $open={ param($u) try { Start-Process chrome $u -ErrorAction Stop } catch { try { Start-Process msedge $u -ErrorAction Stop } catch { Start-Process $u } } }; foreach ($port in 8765..8775) { try { $q=Invoke-WebRequest -UseBasicParsing -TimeoutSec 1 ('http://localhost:' + $port + '/'); if ($q.Headers['X-Nolja']) { Write-Host ('Nolja is already running at port ' + $port + ', opening it again.'); & $open ('http://localhost:' + $port + '/'); exit 0 } } catch {} }; $l=$null; $u=''; foreach ($port in 8765..8775) { $c=New-Object Net.Sockets.TcpClient; $busy=$false; try { $busy=$c.ConnectAsync('127.0.0.1',$port).Wait(300) } catch {}; $c.Close(); if ($busy) { Write-Host ('Port ' + $port + ' is in use, trying the next one'); continue }; $x=New-Object Net.HttpListener; $x.Prefixes.Add('http://localhost:' + $port + '/'); try { $x.Start(); $l=$x; $u='http://localhost:' + $port + '/'; break } catch { $x.Close() } }; if (-not $l) { Write-Host 'Could not open any port between 8765 and 8775.'; Read-Host 'Press Enter to close'; exit 1 }; & $open $u; Write-Host ('Nolja is running at ' + $u + '  (close this window to stop)'); while ($l.IsListening) { $c=$l.GetContext(); $c.Response.AddHeader('X-Nolja','1'); $p=[Uri]::UnescapeDataString($c.Request.Url.AbsolutePath.TrimStart('/')); $f=Join-Path $r $p; if (($p -ne '') -and (Test-Path -LiteralPath $f -PathType Container) -and (-not $p.EndsWith('/'))) { $c.Response.Redirect('/' + $p + '/'); $c.Response.Close(); continue }; if (($p -eq '') -or $p.EndsWith('/')) { $f=Join-Path $f 'index.html' }; if (($p -notmatch '\.\.') -and (Test-Path -LiteralPath $f -PathType Leaf)) { $b=$null; try { $b=[IO.File]::ReadAllBytes($f) } catch {}; if ($null -ne $b) { $e=[IO.Path]::GetExtension($f).ToLower(); if ($mt.ContainsKey($e)) { $c.Response.ContentType=$mt[$e] }; $c.Response.OutputStream.Write($b,0,$b.Length) } else { $c.Response.StatusCode=500 } } else { $c.Response.StatusCode=404 }; $c.Response.Close() }"
